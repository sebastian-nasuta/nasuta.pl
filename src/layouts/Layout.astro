---
import '../styles/global.css';
import { defaultLocale, locales, translations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'nasuta.pl',
  description = 'Layer by layer · Note by note · Line by line',
} = Astro.props;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040406" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400&family=Outfit:wght@200;300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg text-ink min-h-screen overflow-x-hidden selection:bg-amber/25 selection:text-ink">
    <div class="grain" aria-hidden="true"></div>
    <slot />

    <script
      is:inline
      define:vars={{
        i18nLocales: locales,
        i18nDefault: defaultLocale,
        i18nDict: translations,
      }}
    >
      (function () {
        function isSupported(lang) {
          return typeof lang === 'string' && i18nLocales.indexOf(lang) !== -1;
        }

        function applyLocale(lang, persist) {
          const active = isSupported(lang) ? lang : i18nDefault;
          document.documentElement.lang = active;

          if (persist) {
            try {
              localStorage.setItem('nasuta-lang', active);
            } catch (_) {}
          }

          const dict = i18nDict[active] || i18nDict[i18nDefault] || {};

          function getByPath(obj, path) {
            return String(path)
              .split('.')
              .reduce(function (acc, part) {
                return acc && typeof acc === 'object' ? acc[part] : undefined;
              }, obj);
          }

          document.querySelectorAll('[data-i18n-key]').forEach(function (el) {
            const key = el.getAttribute('data-i18n-key');
            if (!key) return;
            const val = getByPath(dict, key) ?? getByPath(i18nDict[i18nDefault], key);
            if (typeof val === 'string') {
              el.textContent = val;
            }
          });

          document.querySelectorAll('[data-set-lang]').forEach(function (btn) {
            const isCurrent = btn.getAttribute('data-set-lang') === active;
            btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          });
        }

        let initial = i18nDefault;
        try {
          const saved = localStorage.getItem('nasuta-lang');
          if (isSupported(saved)) initial = saved;
        } catch (_) {}

        applyLocale(initial, false);

        document.addEventListener('click', function (e) {
          const btn = e.target.closest('[data-set-lang]');
          if (!btn) return;
          const next = btn.getAttribute('data-set-lang');
          if (isSupported(next)) {
            applyLocale(next, true);
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .grain {
    position: fixed;
    inset: -50%;
    width: 200%;
    height: 200%;
    z-index: 50;
    pointer-events: none;
    opacity: 0.032;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .heading-gradient {
    background: linear-gradient(90deg, rgba(240, 237, 230, 0.85) 0%, #ffffff 50%, rgba(223, 155, 82, 0.88) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  [data-set-lang][aria-pressed="true"] {
    color: var(--amber);
    font-weight: 400;
  }
</style>
