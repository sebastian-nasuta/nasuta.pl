---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { defaultLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'nasuta.pl',
  description = 'Line by line · Layer by layer · Note by note',
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID || 'G-JBWJYGPPJR';
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#040406" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400&family=Outfit:wght@200;300;400&display=swap"
      rel="stylesheet"
    />
    {
      gaId && import.meta.env.PROD && (
        <>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            var savedConsent = null;
            try {
              savedConsent = localStorage.getItem('nasuta-consent');
            } catch {}
            gtag('consent', 'default', {
              analytics_storage: savedConsent === 'granted' ? 'granted' : 'denied',
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
            });
            gtag('js', new Date());
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body class="bg-bg text-ink min-h-screen overflow-x-hidden selection:bg-amber/25 selection:text-ink">
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <CookieConsent />

    <script>
      import { defaultLocale, isLocale, locales, t, type Locale } from '../i18n';

      const STORAGE_KEY = 'nasuta-lang';
      let currentLocale: Locale = defaultLocale;

      function applyLocale(lang: Locale, persist: boolean) {
        currentLocale = lang;
        document.documentElement.lang = lang;

        if (persist) {
          try {
            localStorage.setItem(STORAGE_KEY, lang);
          } catch {}
        }

        document.querySelectorAll<HTMLElement>('[data-i18n-key]').forEach((el) => {
          const key = el.dataset.i18nKey;
          if (!key) return;
          const value = t(key, lang);
          const attrs = el.dataset.i18nAttrs;
          if (attrs) {
            attrs.split(',').forEach((attr) => el.setAttribute(attr.trim(), value));
          } else {
            el.textContent = value;
          }
        });

        document.querySelectorAll<HTMLElement>('[data-lang-indicator]').forEach((el) => {
          el.dataset.active = String(el.dataset.langIndicator === lang);
        });
      }

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (isLocale(saved)) currentLocale = saved;
      } catch {}

      applyLocale(currentLocale, false);

      document.addEventListener('click', (e) => {
        const toggleBtn = (e.target as Element | null)?.closest<HTMLElement>('[data-lang-toggle]');
        if (!toggleBtn) return;
        const nextIdx = (locales.indexOf(currentLocale) + 1) % locales.length;
        applyLocale(locales[nextIdx], true);
      });
    </script>
  </body>
</html>
