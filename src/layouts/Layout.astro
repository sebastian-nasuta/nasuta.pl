---
import '../styles/global.css';
import { defaultLocale, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'nasuta.pl',
  description = t('hero.riddleFull'),
} = Astro.props;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040406" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400&family=Outfit:wght@200;300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg text-ink min-h-screen overflow-x-hidden selection:bg-amber/25 selection:text-ink">
    <div class="grain" aria-hidden="true"></div>
    <slot />

    <script>
      import { defaultLocale, isLocale, locales, t, type Locale } from '../i18n';

      const STORAGE_KEY = 'nasuta-lang';
      let currentLocale: Locale = defaultLocale;

      function applyLocale(lang: Locale, persist: boolean) {
        currentLocale = lang;
        document.documentElement.lang = lang;

        if (persist) {
          try {
            localStorage.setItem(STORAGE_KEY, lang);
          } catch {}
        }

        document.querySelectorAll<HTMLElement>('[data-i18n-key]').forEach((el) => {
          const key = el.dataset.i18nKey;
          if (key) el.textContent = t(key, lang);
        });

        document.querySelectorAll<HTMLElement>('[data-lang-indicator]').forEach((el) => {
          el.dataset.active = String(el.dataset.langIndicator === lang);
        });
      }

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (isLocale(saved)) currentLocale = saved;
      } catch {}

      applyLocale(currentLocale, false);

      document.addEventListener('click', (e) => {
        const toggleBtn = (e.target as Element | null)?.closest<HTMLElement>('[data-lang-toggle]');
        if (!toggleBtn) return;
        const nextIdx = (locales.indexOf(currentLocale) + 1) % locales.length;
        applyLocale(locales[nextIdx], true);
      });
    </script>
  </body>
</html>
