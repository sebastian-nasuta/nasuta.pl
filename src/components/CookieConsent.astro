---
import { t } from '../i18n';
---

<aside
  id="cookieConsent"
  role="dialog"
  aria-label="Cookie consent"
  class="hidden fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-sm z-50 border border-white/[0.12] bg-bg/95 backdrop-blur-md p-4 font-mono text-[0.62rem] leading-relaxed tracking-[0.12em] text-ink/70"
>
  <p data-i18n-key="consent.text">{t('consent.text')}</p>
  <div class="mt-3 flex items-center justify-end gap-2 uppercase tracking-[0.2em]">
    <button
      type="button"
      data-consent-action="denied"
      data-i18n-key="consent.decline"
      class="px-3 py-1.5 border border-white/10 hover:border-white/30 text-ink/55 hover:text-ink/85 transition-colors cursor-pointer"
    >
      {t('consent.decline')}
    </button>
    <button
      type="button"
      data-consent-action="granted"
      data-i18n-key="consent.accept"
      class="px-3 py-1.5 border border-amber/40 bg-amber/10 hover:border-amber text-amber transition-colors cursor-pointer"
    >
      {t('consent.accept')}
    </button>
  </div>
</aside>

<script>
  const CONSENT_KEY = 'nasuta-consent';
  const banner = document.getElementById('cookieConsent');

  if (banner) {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(CONSENT_KEY);
    } catch {}

    if (saved !== 'granted' && saved !== 'denied') {
      banner.classList.remove('hidden');
    }

    banner.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-consent-action]');
      const choice = btn?.dataset.consentAction;
      if (choice !== 'granted' && choice !== 'denied') return;

      try {
        localStorage.setItem(CONSENT_KEY, choice);
      } catch {}

      const gtagFn = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      gtagFn?.('consent', 'update', {
        analytics_storage: choice,
      });

      banner.classList.add('hidden');
    });
  }
</script>
