---
import Logo from './Logo.astro';
import { defaultLocale, locales, t } from '../i18n';

const DEFAULT_FREQ_READOUT = '41.20 Hz · 55.00 Hz · 73.42 Hz · 98.00 Hz';
---

<section class="relative w-full h-screen min-h-[640px] overflow-hidden select-none border-b border-white/[0.07]" id="top">
  <canvas id="scene" aria-hidden="true" class="absolute inset-0 w-full h-full z-[1] block cursor-crosshair"></canvas>
  <div class="vignette absolute inset-0 z-[2] pointer-events-none"></div>

  <!-- HUD Overlay inside Hero -->
  <div class="relative z-[3] pointer-events-none w-full h-full p-[clamp(1.5rem,3.5vw,2.75rem)] flex flex-col justify-between">
    <!-- Top HUD row -->
    <div class="relative flex justify-between items-center font-mono text-[0.68rem] max-sm:text-[0.58rem] tracking-[0.22em] max-sm:tracking-[0.14em] uppercase text-ink/45 font-light">
      <div class="pointer-events-auto flex items-center gap-4 sm:gap-6">
        <a href="#top" class="inline-flex items-center gap-2.5 text-ink tracking-[0.34em] font-normal hover:text-amber transition-colors">
          <Logo class="w-5 h-5 sm:w-6 sm:h-6 shrink-0" />
          <span>nasuta.pl</span>
        </a>
        <button
          type="button"
          data-lang-toggle
          aria-label="Toggle language"
          class="inline-flex items-center gap-1.5 text-[0.62rem] tracking-[0.2em] border border-white/10 hover:border-amber/50 bg-white/[0.02] px-2.5 py-1 transition-colors cursor-pointer"
        >
          {locales.map((loc, idx) => (
            <>
              {idx > 0 && <span class="text-white/20">/</span>}
              <span
                data-lang-indicator={loc}
                data-active={loc === defaultLocale ? 'true' : 'false'}
                class="text-ink/45 transition-colors uppercase"
              >
                {loc}
              </span>
            </>
          ))}
        </button>
      </div>

      <nav class="pointer-events-auto hidden md:block text-[0.65rem] tracking-[0.22em] absolute left-1/2 top-1/2 -translate-y-1/2">
        <a href="#projects" class="nav-node group inline-flex items-center w-max whitespace-nowrap py-1 absolute right-2.5 top-1/2 -translate-y-1/2">
          <span class="text-white/25 group-hover:text-amber/70 transition-colors">[</span>
          <span class="px-1.5 text-ink/60 group-hover:text-amber transition-colors">0x01</span>
          <span class="nav-label text-ink/80">
            <span class="pr-1.5" data-i18n-key="nav.projects">{t('nav.projects')}</span>
          </span>
          <span class="text-white/25 group-hover:text-amber/70 transition-colors">]</span>
        </a>
        <a href="#contact" class="nav-node group inline-flex items-center w-max whitespace-nowrap py-1 absolute left-2.5 top-1/2 -translate-y-1/2">
          <span class="text-white/25 group-hover:text-amber/70 transition-colors">[</span>
          <span class="px-1.5 text-ink/60 group-hover:text-amber transition-colors">0x02</span>
          <span class="nav-label text-ink/80">
            <span class="pr-1.5" data-i18n-key="nav.contact">{t('nav.contact')}</span>
          </span>
          <span class="text-white/25 group-hover:text-amber/70 transition-colors">]</span>
        </a>
      </nav>

      <span class="inline-flex items-center gap-2 text-ink/45">
        <span class="pulse-dot"></span>
        <span id="stateReadout">&lt;state:materializing /&gt;</span>
      </span>
    </div>

    <!-- Bottom HUD row -->
    <div class="relative flex justify-between items-center font-mono text-[0.68rem] max-sm:text-[0.58rem] tracking-[0.22em] max-sm:tracking-[0.14em] uppercase text-ink/45 font-light">
      <span class="telemetry" id="freqTelemetry" data-default-text={DEFAULT_FREQ_READOUT}>
        {DEFAULT_FREQ_READOUT}
      </span>
      <a
        href="#projects"
        class="pointer-events-auto hidden sm:inline-flex items-center gap-2 text-ink/40 hover:text-amber transition-colors tracking-[0.3em] text-[0.6rem] absolute left-1/2 -translate-x-1/2"
      >
        <span data-i18n-key="hero.scroll">{t('hero.scroll')}</span>
        <span class="text-amber">↓</span>
      </a>
      <span class="telemetry" id="layerTelemetry">Z: 0.20mm // 215.0°C</span>
    </div>
  </div>

  <!-- Center-Bottom Title Block -->
  <div class="title-block" id="titleBlock">
    <p class="whisper-top">0x00 // Sic parvis magna</p>
    <h1 data-i18n-key="hero.heading" class="hero-heading heading-gradient">
      {t('hero.heading')}
    </h1>
    <div class="divider" aria-hidden="true"></div>
    <p class="riddle">
      <em class="not-italic">Line by line</em><span>·</span><em class="not-italic">Layer by layer</em><span>·</span><em class="not-italic">Note by note</em>
    </p>
  </div>
</section>

<style>
  .vignette {
    background: radial-gradient(circle at 50% 45%, transparent 45%, rgba(2, 2, 4, 0.82) 100%);
  }

  .pulse-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 10px var(--amber);
    animation: blink 3.2s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }

  .title-block {
    position: absolute;
    left: 50%;
    bottom: clamp(4.25rem, 9.5vh, 6.5rem);
    transform: translateX(-50%);
    z-index: 3;
    pointer-events: none;
    text-align: center;
    width: max-content;
    max-width: 92vw;
    padding: 0.5rem 2rem;
  }

  .whisper-top {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--amber);
    opacity: 0;
    margin-bottom: 0.75rem;
    animation: fadeUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .hero-heading {
    font-family: "Outfit", sans-serif;
    font-weight: 200;
    font-size: clamp(1.3rem, 2.9vw, 2.3rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.3;
    margin-right: -0.28em;
    opacity: 0;
    animation: fadeUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }

  .divider {
    width: 48px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(223, 155, 82, 0.5), transparent);
    margin: 0.9rem auto;
    opacity: 0;
    animation: fadeUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.65s forwards;
  }

  .riddle {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.64rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-dim);
    font-weight: 300;
    opacity: 0;
    animation: fadeUp 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
  }

  .riddle span {
    display: inline-block;
    margin: 0 0.65rem;
    color: var(--amber);
    opacity: 0.6;
  }

  .telemetry {
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  .telemetry.active {
    color: var(--amber);
  }

  .nav-label {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    transition:
      max-width 0.38s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .nav-node:hover .nav-label,
  .nav-node:focus-visible .nav-label {
    max-width: 12rem;
    opacity: 1;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero-heading {
      font-size: 1.1rem;
      letter-spacing: 0.18em;
      margin-right: -0.18em;
      white-space: normal;
    }
    .riddle {
      font-size: 0.54rem;
      letter-spacing: 0.16em;
    }
    .riddle span {
      margin: 0 0.3rem;
    }
  }
</style>

<script src="../scripts/hero-scene.ts"></script>
