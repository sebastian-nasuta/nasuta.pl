---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/HeroScene.astro';
import Logo from '../components/Logo.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t } from '../i18n';

const projectEntries = await getCollection('projects');
const projects = [...projectEntries].reverse().map((entry) => entry.data);
const contactEntries = await getCollection('contacts');
---

<Layout>
  <HeroScene />

  <main class="relative z-10 max-w-5xl mx-auto px-6 sm:px-10 py-28 space-y-32">
    <!-- 01 // PROJECTS -->
    <section id="projects" class="scroll-mt-16">
      <SectionHeader
        tagKey="sections.projects.tag"
        titleKey="sections.projects.title"
        statusTag="<form:solid />"
      />

      <div class="mt-12 relative space-y-6">
        {projects.map((node, idx) => (
          <ProjectCard
            node={node}
            isFirst={idx === 0}
            isLast={idx === projects.length - 1}
          />
        ))}
      </div>
    </section>

    <!-- 02 // CONTACT -->
    <section id="contact" class="scroll-mt-16">
      <SectionHeader
        tagKey="sections.contact.tag"
        titleKey="sections.contact.title"
        statusTag="<signal:open />"
      />

      <div class="mt-10 flex flex-wrap items-center gap-4 font-mono text-[0.66rem] tracking-[0.26em] uppercase">
        {contactEntries.map(({ data: link }) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="px-6 py-4 border border-white/[0.1] bg-white/[0.015] text-ink/80 hover:border-amber/60 hover:text-amber transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-white/[0.07] py-8 px-6 sm:px-10">
    <div class="relative max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[0.62rem] tracking-[0.24em] uppercase text-ink/40">
      <a href="#top" class="inline-flex items-center gap-2.5 text-ink/80 hover:text-amber transition-colors">
        <Logo class="w-5 h-5 shrink-0" />
        <span class="tracking-[0.34em]">nasuta.pl</span>
      </a>
      <span class="sm:absolute sm:left-1/2 sm:-translate-x-1/2 inline-flex items-center gap-2">
        <span class="font-sans text-[0.76rem] leading-none text-amber/75 -translate-y-[1.5px]">©</span>
        <span>{new Date().getFullYear()} Sebastian Nasuta</span>
      </span>
      <a href="#top" data-i18n-key="hero.backToTop" class="hover:text-amber transition-colors">
        {t('hero.backToTop')}
      </a>
    </div>
  </footer>

  <script>
    import { initMobileProjectReveal } from '../scripts/mobile-reveal';
    initMobileProjectReveal();
  </script>
</Layout>
